NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase Edge Function that resolves NRP/family code + PIN.
# It must apply rate limits and lockouts, avoid account enumeration, and return
# a Supabase Auth access_token and refresh_token only after successful login.
SUPABASE_AUTH_RESOLVER_URL=https://your-project.supabase.co/functions/v1/auth-nrp-pin

# Edge Function secrets (set with `supabase secrets set`, never in a browser):
# IDENTITY_LOOKUP_SECRET=<random secret, at least 32 characters>
# GATEOPS_BOOTSTRAP_SECRET=<one-time random secret, at least 32 characters>